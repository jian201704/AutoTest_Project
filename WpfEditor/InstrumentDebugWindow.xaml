<Window x:Class="OpenTap.WpfEditor.InstrumentDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instrument Debug"
        Width="900"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Instrument Debug" FontSize="22" FontWeight="SemiBold" Foreground="#183446" />
                <TextBlock Text="Connect, send one command, inspect the response." Foreground="#637783" Margin="0,3,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#E4F2EB" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionStatusText" Text="Disconnected" Foreground="#386B4D" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="Connection">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Transport" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox x:Name="TransportComboBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                          SelectionChanged="TransportComboBox_SelectionChanged" />

                <Grid x:Name="ResourcePanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResourceLabel" Text="Instrument" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ResourceComboBox" Grid.Column="1" DisplayMemberPath="Name" />
                </Grid>
                <Grid x:Name="TcpPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="HostTextBox" Grid.Column="1" Text="127.0.0.1" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="PortTextBox" Grid.Column="3" Text="5025" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Line ending" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="TerminatorComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Timeout (ms)" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TimeoutTextBox" Grid.Row="2" Grid.Column="3" Text="2000" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Command">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="CommandTextBox" Grid.Row="0" Grid.Column="0" MinHeight="34" KeyDown="CommandTextBox_KeyDown" />
                <Button x:Name="SendButton" Grid.Row="0" Grid.Column="1" Content="Send" Click="SendButton_Click" Margin="10,0,0,0"
                        Background="#236B62" Foreground="White" BorderBrush="#236B62" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,9,0,0">
                    <CheckBox x:Name="ReadResponseCheckBox" Content="Wait for response" IsChecked="True" VerticalAlignment="Center" />
                    <TextBlock Text="Encoding" Margin="22,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="EncodingComboBox" Width="150" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Response" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Clear" HorizontalAlignment="Right" Margin="0,8,0,0" Click="ClearButton_Click" />
                <TextBox x:Name="ResponseTextBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" FontFamily="Consolas" />
            </DockPanel>
        </GroupBox>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="#637783" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" Background="#236B62" Foreground="White" BorderBrush="#236B62" />
                <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click" Margin="8,0,0,0" IsEnabled="False" />
                <Button Content="Close" Click="CloseButton_Click" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
