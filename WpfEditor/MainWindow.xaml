<Window x:Class="OpenTap.WpfEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTAP Test Automation"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="PropertyValueTemplate">
            <Grid>
                <TextBlock Text="{Binding Value}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsResourceReference}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ComboBox ItemsSource="{Binding ResourceOptions}"
                          SelectedItem="{Binding SelectedResource, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name"
                          VerticalAlignment="Center">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsResourceReference}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <CheckBox IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PropertyEditTemplate">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="28">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                <Setter Property="Height" Value="150" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OPEN TAP" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="  TEST AUTOMATION" Foreground="#B9D4E5" FontSize="12" VerticalAlignment="Center" Margin="3,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="New" Click="New_Click" />
                    <Button Content="Open" Click="Open_Click" />
                    <Button Content="Import Excel" Click="ImportExcel_Click" />
                    <Button Content="Save" Click="Save_Click" />
                    <Button Content="Save As" Click="SaveAs_Click" />
                    <Separator Width="1" Margin="8,5" Background="#607283" />
                    <Button Content="Add Step" Click="AddStep_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}" />
                    <Button Name="RunButton" Content="▶  Run" Click="Run_Click" Background="#2D9A62" Foreground="White" BorderBrush="#2D9A62" FontWeight="SemiBold" />
                    <Button Name="AbortButton" Content="■  Abort" Click="Abort_Click" IsEnabled="False" Background="#B94A48" Foreground="White" BorderBrush="#B94A48" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" Padding="10,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="#62C88A" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Name="StatusText" Text="Ready" Foreground="White" VerticalAlignment="Center" Margin="5,0,18,0" />
                    <Button Content="DUTs" Click="Duts_Click" Padding="12,3" />
                    <Button Content="Instruments" Click="Instruments_Click" Padding="12,3" />
                    <Button Content="Instrument Debug" Click="InstrumentDebug_Click" Padding="12,3" />
                    <Button Content="Results" Click="Results_Click" Padding="12,3" />
                    <Button Content="Clear Log" Click="ClearLog_Click" Padding="12,3" />
                </StackPanel>
                <TextBlock Name="PathText" DockPanel.Dock="Right" Text="Untitled" Foreground="#C5D3DF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            </DockPanel>
        </Border>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="3.4*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3.5*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Grid.Column="0" Header="Test Steps" Margin="0,0,6,6">
                <DockPanel>
                    <TextBox Name="StepSearchBox" DockPanel.Dock="Top" Margin="4,2,4,8" Padding="7,5" TextChanged="StepSearchBox_TextChanged" ToolTip="Filter step types" />
                    <TreeView Name="StepLibraryTree" SelectedItemChanged="StepLibraryTree_SelectedItemChanged" BorderThickness="0" Margin="4,0,0,0" ItemContainerStyle="{StaticResource CompactTreeItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="1" Header="Test Plan" Margin="0,0,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F7F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,3">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="＋" FontSize="18" Padding="7,0" Click="AddStep_Click" ToolTip="Add step" />
                            <Button Content="−" FontSize="18" Padding="7,0" Click="RemoveSelectedStep_Click" ToolTip="Remove selected step" />
                            <TextBlock Text="Test Plan:" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,5,0" />
                            <TextBlock Text="{Binding PathText.Text, ElementName=PathText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                            <Button Content="▶" Padding="8,2" Margin="16,2,2,2" Click="Run_Click" Background="#D9F1DF" BorderBrush="#6DAA7B" ToolTip="Run test plan" />
                            <Button Content="⏭" Padding="8,2" ToolTip="Run selected step" />
                            <Button Content="↻" Padding="8,2" ToolTip="Refresh" />
                            <TextBlock Name="PlanRunStatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="5">
                        <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="2.15*" /><ColumnDefinition Width=".85*" /><ColumnDefinition Width=".85*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="2.1*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Margin="10,7" />
                                <TextBlock Grid.Column="2" Text="Verdict" FontWeight="SemiBold" Margin="8,7" />
                                <TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold" Margin="8,7" />
                                <TextBlock Grid.Column="4" Text="Flow" FontWeight="SemiBold" Margin="8,7" />
                                <TextBlock Grid.Column="5" Text="Type" FontWeight="SemiBold" Margin="8,7" />
                            </Grid>
                        </Border>
                        <TreeView Name="PlanTree" Grid.Row="1" SelectedItemChanged="PlanTree_SelectedItemChanged" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="White" />
                    </Grid>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="0" Grid.Column="2" Header="Test Step Settings" Margin="0,0,0,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentLightBrush}" Padding="8" Margin="2,2,2,6">
                        <TextBlock Text="Select a test step to inspect its settings." Foreground="#225A78" TextWrapping="Wrap" />
                    </Border>
                    <DataGrid Name="PropertiesGrid" ItemsSource="{Binding Properties}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Margin="2" GridLinesVisibility="Horizontal" CellEditEnding="PropertiesGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Property" Binding="{Binding Name}" IsReadOnly="True" Width="1.25*" />
                            <DataGridTemplateColumn Header="Value" CellTemplate="{StaticResource PropertyValueTemplate}" CellEditingTemplate="{StaticResource PropertyEditTemplate}" Width="1.8*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width=".9*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Header="Log" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,4">
                        <TextBlock Text="Errors 0" Foreground="#B94A48" Margin="6,4,18,4" />
                        <TextBlock Text="Warnings 0" Foreground="#B7791F" Margin="6,4,18,4" />
                        <TextBlock Text="Information" Foreground="{StaticResource MutedBrush}" Margin="6,4" />
                    </StackPanel>
                    <RichTextBox Name="LogText" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="2" Background="#FBFCFD" BorderBrush="{StaticResource BorderBrush}" />
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>